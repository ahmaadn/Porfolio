---
import ThemeButton from "@/components/ThemeButton.astro";
import { Icon } from "astro-icon/components";
import SwitchLocale from "./SwitchLocale.astro";
import { getLangFromUrl, getLocalizedPath, useTranslation } from "@/i18n/utils";

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslation(lang);
const menuItems = [
	{ name: t("nav.projects"), link: getLocalizedPath("/projects", lang) },
	{ name: t("nav.contact"), link: `${getLocalizedPath("/", lang)}#contact` },
];
const homeUrl = getLocalizedPath("/", lang);
---

<nav class="absolute top-0 left-0 z-50 w-full" aria-label={t("nav.navigation")}>
	<div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8">
		<div class="flex flex-1 items-center justify-between">
			<a
				class="text-content text-2xl font-bold tracking-tighter"
				href={homeUrl}
				aria-label={t("nav.home_aria")}>
				AN.
			</a>
			<div class="flex items-center space-x-8">
				<!-- DESKTOP -->
				<ul
					class="hidden items-center space-x-8 text-sm font-bold tracking-widest uppercase md:flex">
					{
						menuItems.map((item) => (
							<li>
								<a
									class="hover:text-content transition-colors"
									href={item.link}
									aria-current={item.link === pathname ? "page" : undefined}>
									{item.name}
								</a>
							</li>
						))
					}
				</ul>
				<div
					class="divide-border inline-flex items-center justify-center space-x-4 divide-x text-base">
					<div class="flex items-center justify-center pr-3">
						<ThemeButton class="hover:text-content transition-colors" />
					</div>
					<div class="pr-3">
						<a
							class="hover:text-content inline-flex h-8 items-center justify-center transition-colors"
							href="/rss.xml"
							target="_blank"
							rel="noopener noreferrer"
							aria-label={t("nav.rss_aria")}>
							<Icon name="ri:rss-line" size="24" />
							<span class="sr-only">{t("nav.rss")}</span>
						</a>
					</div>
					<div class="flex items-center justify-center pr-4">
						<SwitchLocale />
					</div>
				</div>
			</div>
		</div>
		<!-- MOBILE -->
		<div class="md:hidden">
			<ul class="flex items-center space-x-8 text-sm font-bold tracking-widest uppercase">
				{
					menuItems.map((item) => (
						<li>
							<a
								class="hover:text-content transition-colors"
								href={item.link}
								aria-current={item.link === pathname ? "page" : undefined}>
								{item.name}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</nav>
