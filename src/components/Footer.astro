---
import SocialLinks from "@/components/SocialLinks.astro";
import { getLangFromUrl, getLocalizedPath, useTranslation } from "@/i18n/utils";
import { cn } from "@/lib/utils";

interface FooterNavItem {
	label: string;
	href: string;
}

interface Props {
	class?: string;
	mail: string;
	brand?: string;
	tagline?: string;
	navItems?: FooterNavItem[];
	showSocialLinks?: boolean;
}

const {
	class: className = "",
	mail,
	brand = "AN.",
	tagline,
	navItems,
	showSocialLinks = true,
} = Astro.props;

const year = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslation(lang);
const defaultNavItems = [
	{ label: t("nav.home"), href: getLocalizedPath("/", lang) },
	{ label: t("nav.projects"), href: getLocalizedPath("/projects", lang) },
	{ label: t("nav.contact"), href: `${getLocalizedPath("/", lang)}#contact` },
];
const localizedNavItems = navItems ?? defaultNavItems;
---

<footer id="contact" class={cn("mx-auto w-full max-w-6xl pb-10", "text-content-muted", className)}>
	<div class="rounded-3xl px-6 py-8 md:px-8">
		<div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
			<div class="max-w-md space-y-3">
				<p class="text-content text-xl font-semibold tracking-tight">{brand}</p>
				<p class="text-sm leading-relaxed">{tagline ?? t("common.footer.tagline")}</p>
				<a href={`mailto:${mail}`} class="text-content link inline-block text-sm">
					{mail}
				</a>
			</div>

			<div class="space-y-4 md:text-right">
				{
					localizedNavItems.length > 0 && (
						<nav
							aria-label={t("nav.footer_navigation")}
							class="flex flex-wrap gap-4 md:justify-end">
							{localizedNavItems.map((item) => (
								<a href={item.href} class="hover:text-content text-sm transition-colors">
									{item.label}
								</a>
							))}
						</nav>
					)
				}
				{showSocialLinks && <SocialLinks class="text-xs" />}
			</div>
		</div>

		<div class="border-border-muted/70 mt-8 border-t pt-4 text-xs tracking-wide">
			<p>&copy; {year} {brand}. {t("common.footer.copyright")}</p>
		</div>
	</div>
</footer>
